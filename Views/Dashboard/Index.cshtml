@model SubTrack.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container dashboard py-4">
    <section class="dashboard-hero mb-4">
        <div>
            <h1>Track all your subscriptions in one place.</h1>
            <p>Organize every subscription, monitor upcoming renewals, and stay in control of your subscriptions.</p>
        </div>
        <a asp-controller="Subscriptions" asp-action="Create" class="btn btn-light hero-action">
            <i class="bi bi-plus-lg"></i> Add subscription
        </a>
    </section>

    @if (Model.OverdueCount > 0 || Model.DueTodayCount > 0)
    {
        <div class="renewal-alert mb-4" role="alert">
            <div class="alert-icon"><i class="bi bi-bell-fill"></i></div>
            <div>
                <strong>Renewal attention needed</strong>
                <span>
                    @if (Model.OverdueCount > 0)
                    {
                        @($"{Model.OverdueCount} overdue")
                    }
                    @if (Model.OverdueCount > 0 && Model.DueTodayCount > 0)
                    {
                        @: · 
                    }
                    @if (Model.DueTodayCount > 0)
                    {
                        @($"{Model.DueTodayCount} due today")
                    }
                </span>
            </div>
            <a asp-controller="Subscriptions" asp-action="Index">Review subscriptions <i class="bi bi-arrow-right"></i></a>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card metric-card-indigo h-100">
                <div class="card-body">
                    <div class="metric-icon"><i class="bi bi-grid-1x2-fill"></i></div>
                    <div class="metric-label">Active subscriptions</div>
                    <div class="metric-value">@Model.TotalActiveSubscriptions</div>
                    <div class="metric-help">@Model.TotalCancelledSubscriptions paused or cancelled</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card metric-card metric-card-violet h-100">
                <div class="card-body">
                    <div class="metric-icon"><i class="bi bi-calendar-month-fill"></i></div>
                    <div class="metric-label">Monthly run rate</div>
                    <div class="metric-value">₹@Model.MonthlyRecurringCost.ToString("N2")</div>
                    <div class="metric-help">Equivalent monthly spend</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card metric-card metric-card-sky h-100">
                <div class="card-body">
                    <div class="metric-icon"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="metric-label">Annual projection</div>
                    <div class="metric-value">₹@Model.AnnualRecurringCost.ToString("N2")</div>
                    <div class="metric-help">Based on current active plans</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card metric-card metric-card-amber h-100">
                <div class="card-body">
                    <div class="metric-icon"><i class="bi bi-bell-fill"></i></div>
                    <div class="metric-label">Renewals this month</div>
                    <div class="metric-value">@Model.RenewalsThisMonthCount</div>
                    <div class="metric-help">₹@Model.RenewalExposure.ToString("N2") due in the next 7 days</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header">
                    <div>
                        <span class="card-kicker">NEXT 7 DAYS</span>
                        <h5 class="mb-0">Upcoming renewals</h5>
                    </div>
                    <i class="bi bi-calendar3 header-icon"></i>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Subscription</th>
                                <th>Renewal Date</th>
                                <th>Expected Charge</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.UpcomingRenewals.Any())
                            {
                                <tr>
                                    <td colspan="3"
                                        class="text-center text-muted py-4">
                                        No renewals due in the next seven days.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.UpcomingRenewals)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@item.Name</div>
                                            <small class="text-muted">
                                                @item.Category
                                            </small>
                                        </td>

                                        <td class="renewal-date">
                                            @item.NextRenewalDate.ToString("dd MMM yyyy")

                                            @{
                                                var daysUntilRenewal =
                                                    (item.NextRenewalDate.Date - DateTime.Today).Days;
                                            }

                                            @if (daysUntilRenewal == 0)
                                            {
                                                <span class="status-badge status-today">Due today</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-upcoming">@daysUntilRenewal days away</span>
                                            }
                                        </td>

                                        <td>₹@item.Price.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer dashboard-card-footer">
                    <a asp-controller="Subscriptions" asp-action="Index"
                       class="text-decoration-none">
                        View all subscriptions →
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header">
                    <div>
                        <span class="card-kicker">MONTHLY BREAKDOWN</span>
                        <h5 class="mb-0">Spending by category</h5>
                    </div>
                    <i class="bi bi-pie-chart-fill header-icon"></i>
                </div>

                <div class="card-body">
                    @if (!Model.CategorySpending.Any())
                    {
                        <p class="text-muted text-center py-4">
                            Add active subscriptions to see your spending.
                        </p>
                    }
                    else
                    {
                        @foreach (var item in Model.CategorySpending)
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@item.Category</span>
                                    <span class="fw-semibold">
                                        ₹@item.MonthlyCost.ToString("N2")
                                    </span>
                                </div>

                                <div class="progress category-progress">
                                    <div class="progress-bar category-progress-bar"
                                         role="progressbar"
                                         style="width: @(Model.MonthlyRecurringCost > 0 ? (double)(item.MonthlyCost / Model.MonthlyRecurringCost * 100) : 0)%"
                                         aria-valuenow="@(Model.MonthlyRecurringCost > 0 ? (double)(item.MonthlyCost / Model.MonthlyRecurringCost * 100) : 0)"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
