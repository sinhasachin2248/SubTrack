@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="container py-5"><div class="info-page error-page"><i class="bi bi-exclamation-triangle"></i><span class="eyebrow">UNEXPECTED ERROR</span><h1>Something went wrong</h1><p>Please go back and try again. If the issue persists, restart SubTrack.</p>@if (Model.ShowRequestId) { <small>Request ID: <code>@Model.RequestId</code></small> }</div></div>
