
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SubTrack</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet"
          href="~/SubTrack.styles.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body class="dark-ambience">
    <div class="app-shell">
        <aside class="app-sidebar">
            <a asp-controller="Dashboard" asp-action="Index"
               class="brand-link">
                <span class="brand-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </span>
                <span>SubTrack</span>
            </a>

            <div class="sidebar-label">WORKSPACE</div>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index"
                   class="sidebar-link @(
                   ViewContext.RouteData.Values["controller"]?.ToString()
                   == "Dashboard" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Subscriptions" asp-action="Index"
                   class="sidebar-link @(
                   ViewContext.RouteData.Values["controller"]?.ToString()
                   == "Subscriptions" ? "active" : "")">
                    <i class="bi bi-credit-card"></i>
                    <span>Subscriptions</span>
                </a>

                <a asp-controller="Subscriptions" asp-action="Create"
                   class="sidebar-link">
                    <i class="bi bi-plus-circle"></i>
                    <span>Add Subscription</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-footer-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <div class="fw-semibold">SubTrack</div>
                    <small>Subscription manager</small>
                </div>
            </div>
        </aside>

        <main class="app-main">
            <header class="topbar">
                <div>
                    <div class="topbar-title">
                        @ViewData["Title"]
                    </div>
                    <div class="topbar-subtitle">
                        Manage your recurring expenses
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="user-greeting"><i class="bi bi-person-circle"></i><span>Hi, @User.Identity.Name!</span></div>
                    }
                    <a asp-controller="Subscriptions" asp-action="Create" class="topbar-add">
                        <i class="bi bi-plus-lg"></i><span>Add subscription</span>
                    </a>
                    <div class="topbar-badge">
                        <i class="bi bi-circle-fill"></i>
                        Personal Workspace
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="logout-button" title="Sign out"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="login-link">Sign in</a>
                    }
                </div>
            </header>

            <section class="page-content">
                @RenderBody()
            </section>

            <footer class="app-footer">
                <span>SubTrack &copy; @DateTime.Now.Year &nbsp;·&nbsp; Created &amp; Managed by Sachin</span>
                <span>Subscription clarity, all in one place.</span>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
