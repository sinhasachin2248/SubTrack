@model SubTrack.Models.Subscription

@{
    ViewData["Title"] = "Edit Subscription";
}

<div class="container py-4">
    <a asp-action="Index" class="text-decoration-none">
        &larr; Back to Subscriptions
    </a>

    <h2 class="fw-bold mt-3">Edit Subscription</h2>
    <p class="text-muted">Update your subscription details.</p>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Subscription Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label">Category</label>
                        <select asp-for="Category" class="form-select">
                            <option value="Entertainment">Entertainment</option>
                            <option value="Productivity">Productivity</option>
                            <option value="Music">Music</option>
                            <option value="Cloud Storage">Cloud Storage</option>
                            <option value="Fitness">Fitness</option>
                            <option value="Education">Education</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">Price (₹)</label>
                        <input asp-for="Price" type="number" min="0.01"
                               step="0.01" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BillingCycle" class="form-label">Billing Cycle</label>
                        <select asp-for="BillingCycle" class="form-select">
                            <option value="Monthly">Monthly</option>
                            <option value="Yearly">Yearly</option>
                        </select>
                        <span asp-validation-for="BillingCycle" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NextRenewalDate" class="form-label">
                            Next Renewal Date
                        </label>
                        <input asp-for="NextRenewalDate" type="date"
                               class="form-control" />
                        <span asp-validation-for="NextRenewalDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">
                                Subscription is active
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <button type="submit" class="btn btn-primary px-4">
                    Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
