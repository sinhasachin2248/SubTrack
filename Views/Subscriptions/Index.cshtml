@model IEnumerable<SubTrack.Models.Subscription>

@{
    ViewData["Title"] = "Subscriptions";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var subscriptions = Model.ToList();
    var activeCount = subscriptions.Count(s => s.IsActive);
    var dueSoonCount = subscriptions.Count(s => s.IsActive && s.NextRenewalDate.Date >= DateTime.Today && s.NextRenewalDate.Date <= DateTime.Today.AddDays(7));
}

<div class="container subscriptions-page py-4">
    <div class="page-heading mb-4">
        <div>
            <span class="eyebrow page-eyebrow"><i class="bi bi-collection-fill"></i> YOUR LIBRARY</span>
            <h1>Subscriptions</h1>
            <p>Review every recurring expense in one calm, organized place.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary primary-action"><i class="bi bi-plus-lg"></i> Add subscription</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="success-notice mb-4" role="alert"><i class="bi bi-check-circle-fill"></i><span>@TempData["Success"]</span></div>
    }

    <div class="subscription-summary mb-4">
        <div><span class="summary-number">@subscriptions.Count</span><span class="summary-label">Total plans</span></div>
        <div><span class="summary-number">@activeCount</span><span class="summary-label">Active</span></div>
        <div><span class="summary-number summary-attention">@dueSoonCount</span><span class="summary-label">Due in 7 days</span></div>
    </div>

    <form method="get" asp-action="Index" class="filter-panel mb-4">
        <div class="filter-label"><i class="bi bi-sliders"></i><span>Filter subscriptions</span></div>
        <div class="row g-2 flex-grow-1">
            <div class="col-md-5"><div class="input-with-icon"><i class="bi bi-search"></i><input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by subscription name" /></div></div>
            <div class="col-md-3"><select name="category" class="form-select"><option value="">All categories</option>@foreach (var item in categories) { if ((string?)ViewBag.Category == item) { <option value="@item" selected>@item</option> } else { <option value="@item">@item</option> } }</select></div>
            <div class="col-md-2"><select name="status" class="form-select"><option value="">All statuses</option><option value="Active" selected="@(ViewBag.Status == "Active")">Active</option><option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option></select></div>
            <div class="col-md-2 d-flex gap-2"><button type="submit" class="btn btn-dark flex-grow-1">Apply</button><a asp-action="Index" class="btn btn-light filter-reset" title="Clear filters"><i class="bi bi-arrow-counterclockwise"></i></a></div>
        </div>
    </form>

    <div class="subscription-table-card">
        <div class="table-card-heading"><div><h2>All subscriptions</h2><span>@subscriptions.Count result@(subscriptions.Count == 1 ? "" : "s")</span></div><i class="bi bi-credit-card-2-front"></i></div>
        <div class="table-responsive">
            <table class="table subscription-table align-middle mb-0">
                <thead><tr><th>Subscription</th><th>Category</th><th>Plan &amp; cost</th><th>Next renewal</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @if (!subscriptions.Any())
                    {
                        <tr><td colspan="6"><div class="empty-state"><i class="bi bi-inbox"></i><h3>No subscriptions found</h3><p>Try changing your filters, or add a new subscription.</p><a asp-action="Create" class="btn btn-primary">Add subscription</a></div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in subscriptions)
                        {
                            var days = (item.NextRenewalDate.Date - DateTime.Today).Days;
                            var initial = item.Name.Length > 0 ? item.Name[0].ToString().ToUpperInvariant() : "S";
                            <tr>
                                <td><div class="subscription-name"><span class="subscription-avatar">@initial</span><div><strong>@item.Name</strong><small>@(string.IsNullOrWhiteSpace(item.Notes) ? "No note added" : item.Notes)</small></div></div></td>
                                <td><span class="category-tag">@item.Category</span></td>
                                <td><strong>₹@item.Price.ToString("N2")</strong><small class="d-block text-muted">@item.BillingCycle</small></td>
                                <td><strong>@item.NextRenewalDate.ToString("dd MMM yyyy")</strong>@if (!item.IsActive) { <small class="d-block text-muted">Inactive plan</small> } else if (days < 0) { <span class="renewal-flag flag-overdue">@Math.Abs(days) days overdue</span> } else if (days == 0) { <span class="renewal-flag flag-today">Due today</span> } else if (days <= 7) { <span class="renewal-flag flag-soon">In @days days</span> } else { <small class="d-block text-muted">Scheduled</small> }</td>
                                <td><span class="plan-status @(item.IsActive ? "plan-active" : "plan-inactive")"><i class="bi bi-circle-fill"></i>@(item.IsActive ? "Active" : "Cancelled")</span></td>
                                <td><div class="row-actions"><a asp-action="Details" asp-route-id="@item.Id" class="icon-button" title="View @item.Name"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@item.Id" class="icon-button" title="Edit @item.Name"><i class="bi bi-pencil"></i></a><a asp-action="Delete" asp-route-id="@item.Id" class="icon-button icon-button-danger" title="Delete @item.Name"><i class="bi bi-trash3"></i></a></div></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
